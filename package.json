{
  "name": "extension-exporter",
  "displayName": "Extension Exporter",
  "description": "Export all installed extensions to a file with installation scripts for any IDE.",
  "version": "0.0.1",
  "publisher": "Byukusenge-Andrew",
  "author": "Drefault",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "extensions",
    "export",
    "sync",
    "backup",
    "install"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/local/extension-exporter.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension-exporter.export",
        "title": "Extension Exporter: Export Installed Extensions"
      },
      {
        "command": "extension-exporter.import",
        "title": "Extension Exporter: Import Extensions"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3",
    "@vscode/test-electron": "^2.3.2"
  }
}
